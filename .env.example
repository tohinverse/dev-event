# Base URL used for server-side API calls
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# MongoDB connection string
MONGODB_URI=your_mongodb_connection_string_here

# Cloudinary connection string (cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=your_cloudinary_url_here
